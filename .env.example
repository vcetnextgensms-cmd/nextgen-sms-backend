# NextGen SMS backend — copy to .env and fill in.
#
# Two DB connection modes, chosen automatically by whether DB_PROXY_URL is set:
#
#   MODE 1 — Direct connect (campus dev, MySQL reachable on localhost/LAN)
#     Leave DB_PROXY_URL empty. Fill MYSQL_HOST etc below as normal.
#
#   MODE 2 — Proxy (deployed on Render, campus MySQL not directly reachable)
#     Set DB_PROXY_URL to the Cloudflare Quick Tunnel URL fronting db_proxy
#     (see db_proxy/README.md). Set DB_PROXY_KEY to match db_proxy's
#     PROXY_SHARED_KEY. MYSQL_* vars below are then unused by this app —
#     db_proxy has its own copy in db_proxy/.env.
#
#     NOTE: Cloudflare Quick Tunnel URLs change every time cloudflared
#     restarts on the campus machine. DB_PROXY_URL must be updated on
#     Render each time that happens — see db_proxy/README.md.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=student_management

# --- Proxy mode (leave both blank for direct connect) ---
DB_PROXY_URL=
DB_PROXY_KEY=
